<?xml version="1.0" encoding="UTF-8"?><xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="https://finanzonline.bmf.gv.at/rkdb" targetNamespace="https://finanzonline.bmf.gv.at/rkdb" elementFormDefault="qualified">
	<xs:element name="verificationResultList">
		<xs:complexType>
		<xs:sequence>
		<xs:element ref="verificationResult" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
		</xs:complexType>	
	</xs:element>

	<xs:element name="verificationResult">
		<xs:complexType>
		<xs:sequence>
			<xs:element name="verificationId" type="xs:string"/>
			<xs:element name="version" type="xs:integer"/>	
			<xs:element name="verificationName" type="xs:string"/>
			<xs:element name="verificationTextualDescription" type="xs:string" minOccurs="0"/>
			<xs:element ref="verificationState"/>
			<xs:element name="verificationResultDetailedMessage" type="xs:string" minOccurs="0"/>
			<xs:element ref="input" minOccurs="0"/>
			<xs:element ref="output" minOccurs="0"/>
			<xs:element name="verificationTimestamp" type="xs:dateTime"/>
			<xs:element ref="verificationResultList" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	</xs:element>
	
	<xs:element name="verificationState">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="PASS"/>
				<xs:enumeration value="FAIL"/>
				<xs:enumeration value="NOT_EXECUTED"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="input">
		<xs:complexType>
			<xs:sequence>
				<xs:any maxOccurs="unbounded" processContents="lax"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="output">
		<xs:complexType>
			<xs:sequence>
				<xs:any maxOccurs="unbounded" processContents="lax"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>