# Serviceportal — Beispiel-Konfiguration. Kopieren nach .env und Werte ersetzen.
DATABASE_URL=postgresql://portal:portal@localhost:5432/portal

# Signiert die Sitzungen (mindestens 32 Zeichen, zufällig): openssl rand -base64 48
PORTAL_JWT_SECRET=

# Verschlüsselt die TOTP-Geheimnisse in der Datenbank (mindestens 32 Zeichen, zufällig). Geht der Schlüssel
# verloren, müssen alle Benutzer ihre Authenticator-App neu einrichten.
PORTAL_MASTER_KEY=

PORT=3100
LOG_LEVEL=info
NODE_ENV=production

# Hinter einem Reverse-Proxy (Caddy): true, damit Rate-Limit und Log die echte Client-Adresse sehen
TRUST_PROXY=false

# Erlaubter Ursprung der Oberfläche, falls sie NICHT über dieselbe Adresse ausgeliefert wird (leer = kein CORS)
CORS_ORIGIN=

# Nach so vielen Sekunden ohne Meldung gilt eine Box als offline
PORTAL_OFFLINE_NACH_SEKUNDEN=600
