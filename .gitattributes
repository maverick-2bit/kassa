# Shell-Skripte MÜSSEN LF haben — laufen in Linux-Containern (CRLF bricht /bin/sh).
*.sh text eol=lf
*.command text eol=lf
ops/backup/restic-backup.sh text eol=lf
ops/install.sh text eol=lf
ops/Kassa-Setup.command text eol=lf

# Compose-Dateien LF erzwingen (Inline-Shell in Services darf kein CRLF tragen).
docker-compose*.yml text eol=lf
*.cmd -text
# ESC/POS-Golden-Master: Byte-genau — niemals EOL-konvertieren
packages/backend/tests/fixtures/escpos-golden/* -text
# Amtliche FinanzOnline-Schemas: Byte-genau (Prüfsummen in SHA256SUMS), niemals EOL-konvertieren
packages/rksv/tests/fixtures/fon-xsd/* -text
# BMF-Referenzdaten: Byte-genau (Prüfsummen in SHA256SUMS)
packages/rksv/tests/fixtures/bmf-mustercode/** -text

# Vertrauensdatei des Updaters: Schlüsselzeilen, LF erzwingen (ssh-keygen -Y liest sie zeilenweise)
ops/updater/allowed_signers text eol=lf
